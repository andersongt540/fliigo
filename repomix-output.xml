                    text = errorMessage!!,
                    color = MaterialTheme.colorScheme.error,
                    fontSize = 12.sp
                )
            }

            Spacer(modifier = Modifier.height(16.dp))

            Button(
                onClick = {
                    val price = priceStr.toDoubleOrNull()
                    val costPrice = costPriceStr.toDoubleOrNull()
                    val stock = stockStr.toIntOrNull()

                    when {
                        name.isBlank() -> errorMessage = "Ingresa el nombre del producto"
                        price == null || price <= 0.0 -> errorMessage = "Ingresa un precio válido"
                        stock == null || stock < 0 -> errorMessage = "Ingresa un stock válido"
                        else -> {
                            onSave(
                                name.trim(),
                                price,
                                costPrice,
                                provider.ifBlank { null },
                                stock,
                                selectedCategory
                            )
                        }
                    }
                },
                modifier = Modifier
                    .fillMaxWidth()
                    .height(50.dp),
                shape = RoundedCornerShape(12.dp)
            ) {
                Text("Guardar Producto", fontWeight = FontWeight.Bold, fontSize = 16.sp)
            }
        }
    }
}
